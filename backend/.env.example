DATABASE_URL=postgresql://user:password@host/dbname
ADMIN_PASSWORD=choose-a-strong-password
PORT=3001
# Long random string used to sign login tokens. Generate one with the command in the README.
JWT_SECRET=replace-with-a-long-random-string
# Stripe secret key (test mode starts with sk_test_). From the Stripe dashboard, Developers, API keys.
STRIPE_SECRET_KEY=sk_test_replace-me
# The address of the website, used for Stripe's success and cancel redirects
FRONTEND_URL=http://localhost:5173